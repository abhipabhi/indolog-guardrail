# Every setting of the guardrail test chatbot: the format of $HOME/.guardrail-chatbot.env.
#
# start.sh reads that file, and writes it the first time (chmod 600) with the Gemini key you
# paste at its prompt. Keep the file private and OUTSIDE the repository. Never write a key in
# this folder: every value below is a placeholder or a safe default.
#
# One NAME=value a line. A line that starts with # is ignored. A value is taken exactly as written:
# no quotes are needed, nothing is expanded or run, and a key goes in bare, without < > around it.

# Which model answers. none: no model, guardrail only. gemini: Google Gemini, with your own key.
# (openai, groq and ollama are wired too, and have never been run against the real services.)
CHATBOT_MODEL=none

# The key for the provider chosen above (for Ollama, its address). TEST EMAILS THAT PASS THE
# GUARDRAIL ARE SENT TO THAT PROVIDER. Fake or anonymised emails only.
GOOGLE_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=

# Where every run is logged, one row each. Empty: the logs folder inside this folder, which git
# ignores. Or name a folder of your own outside the repository, for example ~/guardrail-chatbot-logs.
CHATBOT_LOG_DIR=

# The guardrail service.
GUARDRAIL_URL=http://localhost:8001

# 1: also call the model after a review, as the backend does: in chat when it answers with a
# caution, and for an incoming email that is sent for review. Empty: only after a pass.
CHATBOT_CALL_MODEL_ON_REVIEW=

# A model name in place of the default (gemini-3.5-flash, gpt-4o-mini, qwen/qwen3-32b,
# gpt-oss:120b-cloud). Providers retire models; leave empty to use the default.
CHATBOT_GEMINI_MODEL=
CHATBOT_OPENAI_MODEL=
CHATBOT_GROQ_MODEL=
CHATBOT_OLLAMA_MODEL=

# Not used by start.sh, which serves this machine only. Needed only if the app is started by
# hand for other machines to reach: a shared password of at least 12 characters.
CHATBOT_PASSWORD=
